[Unit]
Description=AdownDriver Node 1 - cockpit driver monitoring
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
Environment=PYTHONUNBUFFERED=1
# add --headless if no monitor is attached to the cockpit Pi
ExecStart=__REPO__/.venv/bin/python -m adowndriver node1 --headless
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
